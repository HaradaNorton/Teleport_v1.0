{
  "expo": {
    "name": "Teleport",
    "slug": "teleport-messenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0088cc",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.teleport.messenger",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSCameraUsageDescription": "Teleport needs access to your camera for video calls",
        "NSMicrophoneUsageDescription": "Teleport needs access to your microphone for audio and video calls",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.teleport.messenger",
      "versionCode": 1,
      "useNextNotificationsApi": true,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ]
    },
    "notification": {
      "color": "#0088cc",
      "androidMode": "default",
      "androidCollapsedTitle": "New messages"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0088cc",
          "sounds": []
        }
      ]
    ],
    "newArchEnabled": false,
    "extra": {
      "apiUrl": "http://192.168.1.109:8080/api/v1",
      "wsUrl": "ws://192.168.1.109:8080/api/v1/ws",
      "eas": {
        "projectId": "6c00007b-d3f5-438a-8a89-725e0d6eb047"
      }
    }
  }
}
