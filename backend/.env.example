# Server Configuration
PORT=8080
ENV=development
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=teleport_user
DB_PASSWORD=teleport_pass_2024
DB_NAME=teleport
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=5

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass_2024
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Development Mode (mock SMS codes)
MOCK_SMS=true
MOCK_SMS_CODE=12345

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=104857600

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19000,http://localhost:19006

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
